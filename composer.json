{
    "name": "tyhp/core",
    "description": "Tyhp runtime core (PHP 8.4) — type system, generics, typed variables, property accessors",
    "type": "composer-plugin",
    "license": "Apache-2.0",
    "version": "804.0.2",
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "require": {"tyhpdef/php": "@dev"},
            "package": {
                "include": [
                    "./package.tyhpdef"
                ],
                "exclude": [],
                "overlay": [],
                "source": {
                    "tagless": false
                }
            }
        },
        "class": "Tyhp\\Composer\\Plugin"
    },
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "^2.3"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/php-ext-mbstring": "@dev"
    },
    "config": {
        "allow-plugins": {
            "tyhp/core": true
        }
    },
    "suggest": {
        "ext-mbstring": "Unicode-aware string methods (length, substring, toUpper, \u2026); byte APIs are used when missing"
    },
    "autoload": {
        "psr-4": {
            "Tyhp\\": "src/Tyhp/",
            "Tyhp\\Composer\\": "plugin/"
        },
        "files": [
            "src/_functions.php"
        ]
    }
}
